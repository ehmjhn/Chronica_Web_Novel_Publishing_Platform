# ---------------------------------------------------------------------------
# Chronica environment configuration
#
# Copy this file to `.env` and fill in your own values:
#   cp .env.example .env
#
# `.env` is git-ignored, so your real credentials are never committed.
# NOTE: Vite only exposes variables prefixed with VITE_ to the client bundle.
#       Firebase web config values are designed to be public, but you should
#       still restrict your project via Firebase Security Rules.
# ---------------------------------------------------------------------------

# Firebase Web App configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary (image uploads for covers and profile pictures)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
